<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:openDrawer="end">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dashboardContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5F7FA">

    <!-- ========================================================= -->
    <!-- MAIN SCROLLING CONTENT -->
    <!-- ========================================================= -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/dashboardScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="10dp"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/includeBottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="5dp"
            android:paddingEnd="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="20dp">


            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->


            <!-- ================================================= -->
            <!-- SEARCH -->
            <!-- ================================================= -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:background="@color/lightpurple"
                android:layout_height="56dp">

                <LinearLayout
                    android:id="@+id/headerText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">


                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="77dp"
                            android:layout_height="45dp"
                            android:contentDescription="Location"
                            android:src="@drawable/logo" />


                    </LinearLayout>

                </LinearLayout>


                <!-- Notification -->


                <!-- Profile -->

                <ImageButton
                    android:id="@+id/notificationBtn"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/ic_notification"
                    android:contentDescription="@string/notifications"
                    android:padding="2dp"
                    android:src="@drawable/ic_notification"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/profileImage"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/profileImage"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/category_bg"
                    android:contentDescription="Profile"
                    android:padding="10dp"
                    android:src="@drawable/ic_profile"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/textView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="TrekMate Nepal"
                    android:textColor="@color/purple_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/notificationBtn"
                    app:layout_constraintStart_toEndOf="@id/headerText"
                    app:layout_constraintTop_toTopOf="parent" />


            </androidx.constraintlayout.widget.ConstraintLayout>


            <TextView
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:text="Welcome Bibek"
                android:textColor="@color/purple_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="5dp"

                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/searchBar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_edittext"
                    android:drawableStart="@drawable/ic_search_small"
                    android:drawablePadding="10dp"
                    android:hint="@string/search_trek_gear"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="13sp" />

                <!-- Notification is already in header -->

            </LinearLayout>


            <!-- ================================================= -->
            <!-- HERO BANNER -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView
                android:id="@+id/bannerCard"
                android:layout_width="match_parent"
                android:layout_height="175dp"
                android:layout_marginTop="4dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/bannerImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/banner_image"
                        android:scaleType="centerCrop"
                        android:src="@drawable/everest" />

                    <!-- Dark overlay -->

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="165dp"
                        android:background="#55000000" />


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="183dp"
                        android:gravity="bottom"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="240dp"
                            android:layout_height="wrap_content"
                            android:text="Find Gear.\nFind Partners.\nExplore More."
                            android:textColor="@android:color/white"
                            android:textSize="23sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="210dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Your all-in-one solution for trekking."
                            android:textColor="#EEEEEE"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/exploreBtn"
                            android:layout_width="125dp"
                            android:layout_height="38dp"
                            android:layout_marginTop="10dp"
                            android:text="@string/explore_now"
                            android:textAllCaps="false"
                            android:textSize="12sp" />

                    </LinearLayout>

                </FrameLayout>

            </androidx.cardview.widget.CardView>


            <!-- ================================================= -->
            <!-- QUICK ACTIONS -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="5dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="8dp"
                android:orientation="horizontal">

                <!-- Rent Gear -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardRentGear"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:background="@color/lightcream"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:contentDescription="Gear"
                            app:tint="@color/purple"
                            android:src="@drawable/ic_gear" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Gear"
                            android:textColor="@color/purple"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- Find Partner -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPartner"
                    android:layout_width="8dp"
                    android:layout_height="60dp"
                    android:layout_marginEnd="15dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="34dp"
                            android:contentDescription="Find partner"
                            android:src="@drawable/ic_partnericon" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Partners"
                            android:textColor="@color/purple_primary"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- Post Partner Request -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPostGear"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginEnd="15dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:contentDescription="Post Gear"

                            android:src="@drawable/ic_post" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Post Gear"
                            android:textColor="@color/purple_primary"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- Trek Packages -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTreks"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:contentDescription="Trek packages"
                            app:tint="@color/purple_primary"
                            android:src="@drawable/ic_trekking" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Trek Trips"
                            android:textColor="@color/purple_primary"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- POPULAR TREKS -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/popular_treks"
                    android:textColor="@color/purple_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/viewAllTreks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="View all"
                    android:textColor="#5E35B1"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerTreks"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="4"
                tools:listitem="@layout/item_trek" />



            <!-- ================================================= -->
            <!-- CATEGORIES -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/categories"
                    android:textColor="@color/purple"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/viewAllCategories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View all"
                    android:textColor="#5E35B1"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- Categories -->

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Trekking -->

                    <LinearLayout
                        android:id="@+id/categoryTrekking"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:background="@drawable/bg_circle_blue"
                            android:padding="15dp"
                            android:src="@drawable/ic_trekking"
                            app:tint="#1A73E8" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="@string/trekking"
                            android:textColor="@color/purple_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>


                    <!-- Camping -->

                    <LinearLayout
                        android:id="@+id/categoryCamping"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:background="@drawable/bg_circle_red"
                            android:padding="15dp"
                            android:src="@drawable/ic_camping"
                            app:tint="#EA4335" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="@string/camping"
                            android:textColor="@color/purple_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>


                    <!-- Hiking -->

                    <LinearLayout
                        android:id="@+id/categoryHiking"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:background="@drawable/bg_circle_purple"
                            android:padding="15dp"
                            android:src="@drawable/ic_hiking"
                            app:tint="#9C27B0" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="@string/hiking"
                            android:textColor="@color/purple_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>


                    <!-- Climbing -->

                    <LinearLayout
                        android:id="@+id/categoryClimbing"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:background="@drawable/bg_circle_green"
                            android:padding="15dp"
                            android:src="@drawable/ic_climbing"
                            app:tint="#4CAF50" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="@string/climbing"
                            android:textColor="@color/purple_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>





                    <!-- Adventure -->

                    <LinearLayout
                        android:id="@+id/categoryAdventure"
                        android:layout_width="85dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:background="@drawable/bg_circle_teal"
                            android:padding="15dp"
                            android:src="@drawable/ic_mountaineering"
                             />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Mountaineering"
                            android:textColor="@color/purple_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </HorizontalScrollView>


            <!-- ================= FEATURED GEAR ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/featured_gear"
                    android:textColor="@color/purple"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/viewAllGear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View all"
                    android:textColor="#5E35B1"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- TREKKING PARTNERS AVAILABLE -->
            <!-- ================================================= -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerGear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_featured_gear" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trekking Partners"
                        android:textColor="@color/purple"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="People planning upcoming treks"
                        android:textColor="#888888"
                        android:textSize="11sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/viewAllPartners"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View all"
                    android:textColor="#5E35B1"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- Partner cards -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerPartners"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="4"
                tools:listitem="@layout/item_partner" />


            <!-- ================================================= -->
            <!-- RECENT PARTNER REQUESTS -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recent Posts"
                        android:textColor="@color/purple_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="looking for friends"
                        android:textColor="#888888"
                        android:textSize="11sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/viewAllPosts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View all"
                    android:textColor="#5E35B1"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- Recent partner request list -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerPosts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:orientation="vertical"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="4"
                tools:listitem="@layout/item_post" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- ========================================================= -->
    <!-- BOTTOM NAVIGATION -->
    <!-- ========================================================= -->

    <include
        android:id="@+id/includeBottomNav"
        layout="@layout/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Chat FAB -->
    <FrameLayout
        android:id="@+id/fabChatContainer"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/includeBottomNav"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/fabChat"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_chat_fab"
            android:elevation="6dp" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:elevation="7dp"
            android:src="@drawable/ic_chat_fab"
            android:contentDescription="Chat" />

        <TextView
            android:id="@+id/fabBadge"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_badge"
            android:elevation="8dp"
            android:gravity="center"
            android:text="2"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />
    </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Side Menu -->
    <include
        layout="@layout/layout_user_menu"
        android:layout_width="320dp"
