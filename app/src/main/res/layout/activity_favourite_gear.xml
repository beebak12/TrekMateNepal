<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <include android:id="@+id/headerLayout" layout="@layout/layout_header_simple" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerFavouriteGear"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/tvEmptyFavourites"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="No favourite gear yet.\nTap the heart on a gear item to save it."
        android:textColor="@color/secondary_gray"
        android:textSize="16sp"
        app:layout_constraintTop_toTopOf="@id/recyclerFavouriteGear"
        app:layout_constraintBottom_toBottomOf="@id/recyclerFavouriteGear"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
