<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/notification_background">

    <!-- ============================= -->
    <!-- TOP PURPLE HEADER -->
    <!-- ============================= -->

    <!-- TOP CHAT-STYLE HEADER -->
    <LinearLayout
        android:id="@+id/headerBackground"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:background="@color/purple"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            app:tint="@color/white" />

        <!-- Header Title -->
        <TextView
            android:id="@+id/tvNotificationTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Notifications"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="sans"
            android:includeFontPadding="false" />

        <!-- More Button -->
        <ImageButton
            android:id="@+id/btnMore"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more_vert"
            android:contentDescription="More"
            app:tint="@color/white" />

    </LinearLayout>


    <!-- ============================= -->
    <!-- TAB CONTAINER -->
    <!-- ============================= -->

    <LinearLayout
        android:id="@+id/tabContainer"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:background="@drawable/bg_notification_tabs"
        android:elevation="6dp"
        android:translationY="-18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerBackground">

        <!-- ALL -->

        <LinearLayout
            android:id="@+id/tabAll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All"
                android:textColor="@color/purple"
                android:textSize="12sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tvAllCount"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="5dp"
                android:gravity="center"
                android:text="4"
                android:textColor="@android:color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="@drawable/bg_notification_badge" />

        </LinearLayout>


        <!-- BOOKINGS -->

        <LinearLayout
            android:id="@+id/tabBookings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvBookings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bookings"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tvBookingsCount"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="5dp"
                android:gravity="center"
                android:text="2"
                android:textColor="@android:color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="@drawable/bg_notification_badge" />

        </LinearLayout>


        <!-- CHATS -->

        <LinearLayout
            android:id="@+id/tabChats"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvChats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chats"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tvChatsCount"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="5dp"
                android:gravity="center"
                android:text="2"
                android:textColor="@android:color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="@drawable/bg_notification_badge" />

        </LinearLayout>

    </LinearLayout>


    <!-- ============================= -->
    <!-- ACTIVE TAB INDICATOR -->
    <!-- ============================= -->

    <View
        android:id="@+id/tabIndicator"
        android:layout_width="48dp"
        android:layout_height="3dp"
        android:background="@color/purple"
        android:layout_marginStart="42dp"
        android:translationY="-2dp"
        app:layout_constraintTop_toBottomOf="@id/tabContainer"
        app:layout_constraintStart_toStartOf="@id/tabContainer" />


    <!-- ============================= -->
    <!-- NOTIFICATION LIST -->
    <!-- ============================= -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerNotifications"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="12dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/tabIndicator"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ============================= -->
    <!-- EMPTY STATE -->
    <!-- ============================= -->

    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tabIndicator"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:src="@drawable/ic_notifications_none"
            android:contentDescription="No notifications"
            app:tint="@color/text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="No notifications"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:includeFontPadding="false" />

    </LinearLayout>


    <!-- ============================= -->
    <!-- BOTTOM NAVIGATION -->
    <!-- ============================= -->

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_bottom_navigation"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- DASHBOARD -->

        <LinearLayout
            android:id="@+id/navDashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:src="@drawable/ic_home"
                android:contentDescription="Dashboard"
                app:tint="@color/nav_gray" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Dashboard"
                android:textColor="@color/nav_gray"
                android:textSize="8sp"
                android:includeFontPadding="false" />

        </LinearLayout>


        <!-- PACKAGES -->

        <LinearLayout
            android:id="@+id/navPackages"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:src="@drawable/ic_package"
                android:contentDescription="Packages"
                app:tint="@color/nav_gray" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Packages"
                android:textColor="@color/nav_gray"
                android:textSize="8sp"
                android:includeFontPadding="false" />

        </LinearLayout>


        <!-- BOOKINGS -->

        <LinearLayout
            android:id="@+id/navBookings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:src="@drawable/ic_calendar"
                android:contentDescription="Bookings"
                app:tint="@color/nav_gray" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Bookings"
                android:textColor="@color/nav_gray"
                android:textSize="8sp"
                android:includeFontPadding="false" />

        </LinearLayout>


        <!-- CHAT -->

        <LinearLayout
            android:id="@+id/navChat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:src="@drawable/ic_chat"
                android:contentDescription="Chat"
                app:tint="@color/nav_gray" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Chat"
                android:textColor="@color/nav_gray"
                android:textSize="8sp"
                android:includeFontPadding="false" />

        </LinearLayout>


        <!-- MORE - SELECTED -->

        <LinearLayout
            android:id="@+id/navMore"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:src="@drawable/ic_person"
                android:contentDescription="More"
                app:tint="@color/purple" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="More"
                android:textColor="@color/purple"
                android:textSize="8sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
