<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/lightpurple"
        android:padding="14dp">

        <ImageView
            android:id="@+id/imgGear"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Gear image"
            android:scaleType="centerCrop"
            android:src="@drawable/jacket" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtGearName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Down Jacket"
                android:textColor="@color/purple_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="20 Aug 2026 → 27 Aug 2026"
                android:textColor="@color/purple_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtQtyWeeks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Qty 1 · 1 week"
                android:textColor="@color/purple_primary"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/btnRemoveItem"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="Remove item"
                android:src="@drawable/ic_cancel"
                app:tint="@color/purple_primary" />

            <TextView
                android:id="@+id/txtSubtotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Rs. 2,000"
                android:textColor="@color/purple_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
