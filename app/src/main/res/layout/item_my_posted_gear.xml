<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp" android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp" app:cardElevation="2dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <ImageView android:id="@+id/imgGear" android:layout_width="92dp" android:layout_height="92dp" android:contentDescription="Gear image" android:scaleType="centerCrop" android:src="@drawable/jacket" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                <TextView android:id="@+id/txtGearName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Gear" android:textColor="@color/purple_primary" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:id="@+id/txtGearDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Category • Price" android:textColor="@color/secondary_gray" android:textSize="13sp" />
                <TextView android:id="@+id/txtGearStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Available" android:textColor="@color/success_green" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
            <Button android:id="@+id/btnEditGear" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="Edit" android:textAllCaps="false" app:backgroundTint="@color/purple_primary" />
            <Button android:id="@+id/btnGearStatus" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:layout_marginStart="6dp" android:text="Status" android:textAllCaps="false" app:backgroundTint="@color/purple" />
            <Button android:id="@+id/btnDeleteGear" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:layout_marginStart="6dp" android:text="Delete" android:textAllCaps="false" app:backgroundTint="@color/red" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
