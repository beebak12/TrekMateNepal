<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/lightpurple"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Left Image -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgPost"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:scaleType="centerCrop"
            android:src="@drawable/everest"
            app:shapeAppearanceOverlay="@style/RoundedSquare8" />

        <!-- Middle Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtPostTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Looking for partner for Everest Base Camp"
                android:textColor="@color/purple_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtAuthorLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Aayush Rai  •  Kathmandu"
                android:textColor="@color/purple_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtDateDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="20 May – 2 Jun 2025  •  12 Days"
                android:textColor="@color/purple_primary"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Right Side: Interested + Join Button -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtInterested"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 interested"
                android:textColor="@color/purple_primary"
                android:textSize="11sp" />

            <!-- Overlapping profile icons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">
                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/partner1"
                    app:shapeAppearanceOverlay="@style/CircleImageStyle" />
                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="-8dp"
                    android:src="@drawable/partner2"
                    app:shapeAppearanceOverlay="@style/CircleImageStyle" />
                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="-8dp"
                    android:src="@drawable/partner3"
                    app:shapeAppearanceOverlay="@style/CircleImageStyle" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnJoin"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="70dp"
                android:layout_height="36dp"
                android:layout_marginTop="10dp"
                android:padding="0dp"
                android:text="Join"
                android:textAllCaps="false"
                android:textColor="@color/purple_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:strokeColor="@color/purple_primary"
                app:strokeWidth="2dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
